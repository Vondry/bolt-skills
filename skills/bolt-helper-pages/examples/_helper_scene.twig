{#
  Error scene — shared markup for every helper page.
  Uses purely scoped semantic classes styled in _helper_scene_styles.twig.
  Every text param is escaped. To pass markup (a translation with <a>), pass a Twig\Markup
  value, e.g. built with {% set lead %}…{% endset %}; never disable escaping here.
  Does NOT use arbitrary Tailwind utility classes, preventing CSS bundle bloat.

  Params:
    code      — optional: status code shown as the background watermark (e.g. '404', '403', '500');
                the 503 page leaves it out
    eyebrow   — small label (e.g. 'Chyba 404 · Stránka nenalezena')
    heading   — main h1 text
    lead      — explanatory paragraph
    field_key — optional: label for requested path
    field_val — optional: requested URL (e.g. the origin)
    field_val_strong — optional: part shown in bold after field_val (e.g. the path)
    progress  — optional boolean: show maintenance progress bar
    buttons   — optional array of { label, href, variant }
    note      — optional footnote / contact note
#}
<section class="helper-scene">
    <div class="helper-container">
        <div class="helper-card">

            {% if code is defined and code is not empty %}
                <span class="helper-ghost" aria-hidden="true">{{ code }}</span>
            {% endif %}

            <div class="helper-content">
                {% if eyebrow is defined and eyebrow is not empty %}
                    <span class="helper-eyebrow">{{ eyebrow }}</span>
                {% endif %}

                <h1 class="helper-heading">{{ heading }}</h1>

                <p class="helper-lead">{{ lead }}</p>

                {% if progress is defined and progress %}
                    <div class="helper-progress" role="presentation"></div>
                {% endif %}

                {% if field_val is defined and field_val is not empty %}
                    <div class="helper-field">
                        <span class="helper-field-key">{{ field_key|default('Požadovaná adresa') }}:</span>
                        <span class="helper-field-val">{{ field_val }}{% if field_val_strong is defined %}<strong>{{ field_val_strong }}</strong>{% endif %}</span>
                    </div>
                {% endif %}

                {% if buttons is defined and buttons is not empty %}
                    <div class="helper-actions">
                        {% for b in buttons %}
                            <a href="{{ b.href }}" class="helper-btn helper-btn--{{ b.variant|default('primary') }}">
                                {{ b.label }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if note is defined and note is not empty %}
                    <p class="helper-note">{{ note }}</p>
                {% endif %}
            </div>

        </div>
    </div>
</section>
