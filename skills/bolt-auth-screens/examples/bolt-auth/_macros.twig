    {%- set icon = icons[name] -%}
    <svg class="ba-icon ba-icon--{{ name }}" viewBox="0 0 {{ icon[0] }} 512" width="{{ (icon[0] / 512)|round(4) }}em" height="1em" aria-hidden="true" focusable="false"><path fill="currentColor" d="{{ icon[1] }}"/></svg>
