{#
  An alert: always an icon and words, never colour alone. kind: 'success' (role status) or
  'danger' (role alert).
#}
{% macro alert(kind, message) %}
    {%- import _self as ba -%}
    <div class="ba-alert is-{{ kind }}" role="{{ kind == 'success' ? 'status' : 'alert' }}">
        {{- ba.icon(kind == 'success' ? 'check-circle' : 'exclamation-circle') -}}
        <span>{{ message }}</span>
    </div>
{%- endmacro %}

{#
  A password field with the reveal button. `field` is the form view of a password input; `label`
  the translated label; `invalid` marks the field at fault; `link` ({href, label}) puts a link on
  the label row (the login's forgotten password); `autocomplete` is 'current-password' to sign
  in, 'new-password' to set one. The button starts hidden and js/bolt-auth.js shows it, so without
  JavaScript nothing is offered that does not work. Nothing is printed with |raw. The input is
  always type="password" without a value, whatever form type Bolt uses for it.
#}
{% macro password(field, label, invalid = false, link = null, autocomplete = 'current-password') %}
    {%- import _self as ba -%}
    <div class="ba-field">
        {% if link %}
            <div class="ba-label-row">
                <label class="ba-label" for="{{ field.vars.id }}">{{ label }}</label>
                <a class="ba-link" href="{{ link.href }}">{{ link.label }}</a>
            </div>
        {% else %}
            <label class="ba-label" for="{{ field.vars.id }}">{{ label }}</label>
        {% endif %}
        <div class="ba-input-group">
            {#- Always type="password" and never a value: Bolt's login field (PasswordWithPreviewType)
                has no password parent, so the plain form theme would render a text input. -#}
            {{ form_widget(field, {type: 'password', value: '', attr: field.vars.attr|merge({
                class: 'ba-input' ~ (invalid ? ' is-invalid' : ''),
                autocomplete: autocomplete
            })|merge(invalid ? {'aria-invalid': 'true', 'aria-describedby': 'ba-error'} : {})}) }}
            <button class="ba-reveal" type="button" hidden aria-controls="{{ field.vars.id }}" aria-pressed="false"
                    aria-label="{{ 'bolt_auth.show_password'|trans }}"
                    data-ba-reveal data-label-show="{{ 'bolt_auth.show_password'|trans }}" data-label-hide="{{ 'bolt_auth.hide_password'|trans }}">
                {{- ba.icon('eye') }}{{ ba.icon('eye-slash') -}}
            </button>
        </div>
    </div>
{%- endmacro %}

{# The validation messages of one form field, as the single error line under the fields. #}
{% macro errors(field) %}
    {%- import _self as ba -%}
    {%- for error in field.vars.errors -%}
        <p class="ba-help is-error" id="ba-error" role="alert">{{ ba.icon('exclamation-circle') }}<span>{{ error.message }}</span></p>
    {%- endfor -%}
{%- endmacro %}
