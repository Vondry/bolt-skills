# Use the front controller as index file. It serves as a fallback solution when
# every other rewrite/redirect fails (e.g. in an aliased environment without
# mod_rewrite). Additionally, this reduces the matching process for the
# start page (path "/") because otherwise Apache will apply the rewriting rules
# to each configured DirectoryIndex file (e.g. index.php, index.html, index.pl).
#DirectoryIndex index.php

# Static text files served directly by Apache (e.g. robots.txt) are UTF-8.
# Responses from Symfony, such as /llms.txt, set their own charset.
AddDefaultCharset UTF-8

# Safety net for the folders outside the allowlist below (the public root, assets/, bundles/):
# sources, configuration, dumps and backups are never served, wherever they end up. The theme,
# uploads and thumbnails are protected more strictly by the allowlist in the mod_rewrite block.
<IfModule mod_authz_core.c>
    <FilesMatch "(\.(twig|ya?ml|neon|lock|ts|md|psd|ini|sql|sqlite3?|bak|old|orig|swp|log|sh|dist)|^\.DS_Store|^(composer|package|package-lock|tsconfig)\.json|\.config\.[cm]?js)$">
        Require all denied
    </FilesMatch>
    # Environment files (.env, .env.local, …) must never be served, wherever they end up.
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>

# Security headers (bolt-htaccess + bolt-security-hardening). Pages rendered by Symfony get their
# headers from nelmio_security (config/packages/nelmio_security.yaml); these lines cover the files
# Apache serves directly (CSS, JS, images, uploads) and add what nelmio does not send.
<IfModule mod_headers.c>
    # HTTPS only from now on. Browsers ignore the header on plain HTTP, so sending it always is safe.
    # Add "; includeSubDomains" only when every subdomain has a certificate.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Do not advertise the PHP version.
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Files Apache serves itself get the basics nelmio_security sends with every page. (PHP
    # responses are left alone, otherwise the headers would be sent twice.) The conditions test the
    # file on disk: after the root .htaccess rewrite, the request URI starts with /public/.
    <If "%{REQUEST_FILENAME} !~ m#\.php$#">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </If>

    # Uploads and thumbnails never run scripts — not even an HTML or SVG file opened directly
    # (the sandbox gives it no origin and no scripts). PDFs are left out: Chrome refuses to show a
    # PDF under a sandbox policy.
    <If "%{REQUEST_FILENAME} =~ m#/public/(files|thumbs)/# && %{REQUEST_FILENAME} !~ m#\.pdf$#i">
        Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
    </If>
</IfModule>

# Static file caching — the ONE mod_expires block of this file (bolt-htaccess + bolt-asset-caching).
<IfModule mod_expires.c>
    ExpiresActive On

    # Images (uploads in public/files/ and disk thumbnails in public/thumbs/)
    ExpiresByType image/avif "access plus 2 months"
    ExpiresByType image/gif "access plus 2 months"
    ExpiresByType image/jpeg "access plus 2 months"
    ExpiresByType image/png "access plus 2 months"
    ExpiresByType image/svg+xml "access plus 2 months"
    ExpiresByType image/webp "access plus 2 months"

    # Documents
    ExpiresByType application/pdf "access plus 2 months"

    # Frontend assets (styles, scripts) — cache-busted with ?v={{ theme.assets_version }}.
    # Apache serves .js as text/javascript (newer mime.types) or application/javascript (older).
    ExpiresByType text/css "access plus 2 months"
    ExpiresByType text/javascript "access plus 2 months"
    ExpiresByType application/javascript "access plus 2 months"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# By default, Apache does not evaluate symbolic links if you did not enable this
# feature in your server configuration. Uncomment the following line if you
# install assets as symlinks or if you experience problems related to symlinks
# when compiling LESS/Sass/CoffeScript assets.
# Options +FollowSymlinks

# Disabling MultiViews prevents unwanted negotiation, e.g. "/index" should not resolve
# to the front controller "/index.php" but be rewritten to "/index.php/index".
# Left commented on purpose: on hosts whose AllowOverride does not include Options (common on
# shared hosting), an Options line in .htaccess makes every request answer 500. Enable it where
# the host allows it — or ask the host to disable MultiViews for the site.
#<IfModule mod_negotiation.c>
#    Options -MultiViews
#</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Front controller or hosting folder in the requested URL (Pitfall 10). Symfony takes the
    # script path as the base URL whenever the path contains "index.php", and the folder prefix
    # when the site is requested under it (WEDOS: /domains/<domain>/public/); Bolt then caches that
    # base into canonical links, and the sitemap and llms.txt print it. The conditions read the
    # request line as the visitor sent it (THE_REQUEST), which internal rewrites — the root
    # .htaccess, the host's own forwarding, the front controller below — never change. The
    # redirects go straight to https:// (behind a TLS proxy Apache itself sees http).
    # /index.php, /index.php/page, /sub/index.php/page → the same path without /index.php:
    RewriteCond %{THE_REQUEST} ^\S+\s([^?\s]*?)/index\.php(?:/([^?\s]*))?(?:\?\S*)?\s
    RewriteRule ^ https://%{HTTP_HOST}%1/%2 [R=301,L,NE]
    # Any other path naming index.php (/page/index.phpx) — no page has such a URL:
    RewriteCond %{THE_REQUEST} ^\S+\s[^?\s]*index\.php
    RewriteRule ^ - [R=404,L]
    # /domains/<this host>/public/page → /page (only the requested host's own folder):
    RewriteCond %{HTTP_HOST}::%{THE_REQUEST} ^([^:]+)::\S+\s/domains/\1(?:/public)?(?:/([^?\s]*))?(?:\?\S*)?\s [NC]
    RewriteRule ^ https://%1/%2 [R=301,L,NE]

    # Theme build folders: node_modules/ (created by npm inside public/theme/<theme>/) exposes
    # every dependency's sources and versions; .git/ exposes the repository. Deny both.
    RewriteRule (^|/)(node_modules|\.git)(/|$) - [F,L]

    # Only the front controller runs PHP. A forgotten info.php, adminer.php or backup script in
    # public/ is refused instead of executed (the allowlist below already covers theme/, files/
    # and thumbs/).
    RewriteRule ^(?!index\.php$).+\.php$ - [F,L]

    # Allowlist: in the folders that mix public files with sources or uploads, only known static
    # files are served and everything else is 403 — a forgotten file type stays private.
    # theme/<theme>/: the built assets in css/, js/, img/, images/ and fonts/. Templates, theme.yaml,
    # package.json, build configs, TypeScript sources and anything at the theme root are denied.
    RewriteCond $0 !^theme/[^/]+/(css|js|img|images|fonts)/([^/]+/)*[^/]+\.(css|js|avif|gif|ico|jpe?g|png|svg|webp|woff2?|ttf|otf|webmanifest|xml|pdf|mp4|webm)$ [NC]
    RewriteRule ^theme/.* - [F,L]

    # files/ (uploads) and thumbs/ (thumbnails): only the file types an upload may have — the
    # accept_file_types / accept_media_types lists of bolt-security-hardening, plus svg for SVGs
    # uploaded earlier (served under the sandbox policy above). A missing thumbnail still reaches
    # Bolt below, which generates it.
    RewriteCond $0 !\.(avif|gif|ico|jpe?g|png|svg|tiff?|webp|pdf|txt|docx?|xlsx?|pptx?|epub|zip|tgz|mp3|ogg|wav|m4a|mp4|m4v|ogv|webm|wmv|avi)$ [NC]
    RewriteRule ^(files|thumbs)/.* - [F,L]

    # Determine the RewriteBase automatically and set it as environment variable.
    # If you are using Apache aliases to do mass virtual hosting or installed the
    # project in a subdirectory, the base path will be prepended to allow proper
    # resolution of the index.php file and to redirect to the correct URI. It will
    # work in environments without path prefix as well, providing a safe, one-size
    # fits all solution. But as you do not need it in this case, you can comment
    # the following 2 lines to eliminate the overhead.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Sets the HTTP_AUTHORIZATION header removed by Apache
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Redirect to URI without front controller to prevent duplicate content
    # (with and without `/index.php`). Only do this redirect on the initial
    # rewrite by Apache and not on subsequent cycles. Otherwise we would get an
    # endless redirect loop (request -> rewrite to front controller ->
    # redirect -> request -> ...).
    # So in case you get a "too many redirects" error or you always get redirected
    # to the start page because your Apache does not expose the REDIRECT_STATUS
    # environment variable, you have 2 choices:
    # - disable this feature by commenting the following 2 lines or
    # - use Apache >= 2.3.9 and replace all L flags by END flags and remove the
    #   following RewriteCond (best solution)
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,END]

    # If the requested filename exists, simply serve it.
    # We only want to let Apache serve files and not directories.
    # Rewrite all other queries to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [END]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        # When mod_rewrite is not available, we instruct a temporary redirect of
        # the start page to the front controller explicitly so that the website
        # and the generated links can still be used.
        RedirectMatch 307 ^/$ /index.php/
        # RedirectTemp cannot be used instead
    </IfModule>
</IfModule>
