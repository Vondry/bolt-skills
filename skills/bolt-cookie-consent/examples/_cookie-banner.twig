{#
  Cookie Consent Banner — Czech ZEK § 89 / GDPR / Google Consent Mode v2 Compliant.

  Compliance Highlights:
    1. Opt-in: Analytical & marketing cookies are BLOCKED until active user confirmation.
    2. Equal Visual Prominence: 'Odmítnout vše' and 'Přijmout vše' share the SAME classes
       (colour, weight, size, shadow) — only the label differs (no dark pattern).
    3. Granular Preferences: Analytics and Marketing can be toggled independently (defaults OFF, no pre-ticked boxes).
    4. Link to Full Policy: Links to {{ locale_link('/zasady-ochrany-osobnich-udaju') }}.
    5. Easy Revocation: any [data-cookie-settings] button (footer "Nastavení cookies", privacy page)
       and the global window.resetCookieConsent() re-open the banner.
    6. Keyboard Accessibility: role="dialog", aria attributes, focus trap on Tab key.

  Behaviour lives in js/src/cookie-consent.ts (imported by js/src/index.ts) — no inline
  scripts or onclick handlers, so a strict Content-Security-Policy keeps working.
  The ids (cookie-btn-accept, cookie-btn-reject, …) are kept for verify.sh and analytics tagging.

  Translation keys: cookie.*
#}

{% set consent_button = 'w-full sm:w-auto rounded-sm bg-accent hover:bg-accent-hover px-5 py-2.5 text-sm font-semibold text-accent-ink shadow-sm transition-colors cursor-pointer text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-night-ink' %}

<div id="cookie-banner"
     data-cookie-banner
     role="dialog"
     aria-modal="false"
     aria-labelledby="cookie-banner-title"
     aria-describedby="cookie-banner-desc"
     tabindex="-1"
     hidden
     class="fixed inset-x-0 bottom-0 z-50 p-3 sm:p-5 font-body translate-y-full transition-transform duration-500 ease-out outline-none">

    <div class="mx-auto w-full max-w-4xl bg-night text-night-ink rounded-md border border-night-stroke shadow-2xl overflow-hidden">

        {# Main Header & Description #}
        <div class="p-5 sm:p-6 flex flex-col gap-4">
            <div class="flex items-start gap-4">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-sm bg-accent text-accent-ink shadow-md">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="currentColor">
                        <path d="M21 12.4A9 9 0 1 1 11.6 3a3.3 3.3 0 0 0 4.2 4.2A3.3 3.3 0 0 0 21 12.4ZM8.2 9.6a1.2 1.2 0 1 0 0-2.4a1.2 1.2 0 0 0 0 2.4Zm.8 6.8a1.4 1.4 0 1 0 0-2.8a1.4 1.4 0 0 0 0 2.8Zm5.4-1.8a1.1 1.1 0 1 0 0-2.2a1.1 1.1 0 0 0 0 2.2Z"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 id="cookie-banner-title" class="text-lg font-bold text-night-ink">
                        {{ __('cookie.title') }}
                    </h2>
                    <p id="cookie-banner-desc" class="mt-1 text-sm text-night-ink-2 leading-relaxed">
                        {{ __('cookie.text') }}
                        <a href="{{ locale_link('/zasady-ochrany-osobnich-udaju') }}"
                           target="_blank"
                           rel="noopener"
                           class="font-medium text-night-ink underline underline-offset-2 hover:text-accent-ink-2 transition-colors">
                            {{ __('cookie.details') }}
                        </a>.
                    </p>
                </div>
            </div>

            {# Granular Preferences (Toggles) — revealed by the "Nastavení" button #}
            <div id="cookie-prefs" hidden class="flex flex-col divide-y divide-night-stroke border-y border-night-stroke my-2">
                {# 1. Necessary (always locked) #}
                <div class="flex items-center justify-between py-3">
                    <div class="flex flex-col">
                        <span class="text-sm font-semibold text-night-ink">{{ __('cookie.necessary.title') }}</span>
                        <span class="text-xs text-night-ink-3">{{ __('cookie.necessary.desc') }}</span>
                    </div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-night-ink-3 bg-night-deep px-2 py-1 rounded-sm">
                        {{ __('cookie.always_active') }}
                    </span>
                </div>

                {# 2. Analytics (unchecked by default) #}
                <label class="flex items-center justify-between py-3 cursor-pointer">
                    <div class="flex flex-col pr-4">
                        <span class="text-sm font-semibold text-night-ink">{{ __('cookie.analytics.title') }}</span>
                        <span class="text-xs text-night-ink-3">{{ __('cookie.analytics.desc') }}</span>
                    </div>
                    <input type="checkbox" id="cookie-pref-analytics" data-cookie-pref="analytics" class="size-4 accent-accent rounded-sm cursor-pointer">
                </label>

                {# 3. Marketing (unchecked by default) #}
                <label class="flex items-center justify-between py-3 cursor-pointer">
                    <div class="flex flex-col pr-4">
                        <span class="text-sm font-semibold text-night-ink">{{ __('cookie.marketing.title') }}</span>
                        <span class="text-xs text-night-ink-3">{{ __('cookie.marketing.desc') }}</span>
                    </div>
                    <input type="checkbox" id="cookie-pref-marketing" data-cookie-pref="marketing" class="size-4 accent-accent rounded-sm cursor-pointer">
                </label>
            </div>
        </div>

        {# Action Buttons: the first layer offers Accept and Reject with identical styling #}
        <div class="p-4 sm:p-5 bg-night-deep border-t border-night-stroke flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-2.5">
            <button type="button"
                    id="cookie-btn-toggle-prefs"
                    data-cookie-toggle-prefs
                    aria-expanded="false"
                    aria-controls="cookie-prefs"
                    data-label-open="{{ __('cookie.customize') }}"
                    data-label-close="{{ __('cookie.hide_details') }}"
                    class="order-3 sm:order-1 sm:mr-auto text-sm text-night-ink-2 hover:text-night-ink underline underline-offset-4 py-2 cursor-pointer transition-colors text-left sm:text-center">
                {{ __('cookie.customize') }}
            </button>

            <button type="button"
                    id="cookie-btn-reject"
                    data-cookie-reject
                    class="order-1 sm:order-2 {{ consent_button }}">
                {{ __('cookie.reject') }}
            </button>

            <button type="button"
                    id="cookie-btn-accept"
                    data-cookie-accept
                    class="order-2 sm:order-3 {{ consent_button }}">
                {{ __('cookie.accept') }}
            </button>

            {# Save customized choices (replaces Accept while preferences are open) #}
            <button type="button"
                    id="cookie-btn-save"
                    data-cookie-save
                    hidden
                    class="order-2 sm:order-3 {{ consent_button }}">
                {{ __('cookie.save') }}
            </button>
        </div>
    </div>
</div>
