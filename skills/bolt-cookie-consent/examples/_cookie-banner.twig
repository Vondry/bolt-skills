{#
  partials/_cookie-banner.twig — two-layer cookie banner (bolt-cookie-consent).
  Requirement IDs refer to references/guidelines.cs.md.

  Layer 1 (non-modal bar at the bottom, CB-04): who the controller is, what for, to whom, how to
  withdraw (CB-14); "Odmítnout vše" and "Přijmout vše" as buttons with the SAME classes
  (CB-10–CB-12) and "Nastavení cookies" (CB-13). The page stays usable (CB-03); it never takes
  focus (CB-60) and never disappears on its own (CB-62). Hidden on the privacy page (PP-05).

  Layer 2 (<dialog>, "Nastavení cookies"): a switch per consent category, off by default (CB-20),
  the item list of each category (CB-21) and "Uložit výběr", "Přijmout vše", "Odmítnout vše"
  (CB-22). Also opened by every [data-cookie-settings] button (footer, privacy page — CB-30).

  All data comes from theme.yaml (privacy:); nothing renders when no consent category is used.
  Behaviour: js/src/cookie-consent.ts (data-cookie-* hooks, no inline scripts).

  Adapting to the design: change the class variables below (tokens from bolt-tailwind-theme).
  consent_button must stay shared by every Accept / Reject / Save button — verify.sh compares
  them — and keep a text contrast of at least 4.5:1. Never colour Reject as a warning (CB-12).

  Translation keys: cookie.*
#}
{% import 'partials/_privacy-macros.twig' as privacy_ui %}

{# Plain arrays: theme.yaml blocks come as Bolt collections — |column() finds nothing in them and a key
   set to ~ throws on access. toArray() converts recursively. #}
{% set privacy = config.get('theme/privacy') %}
{% set privacy = privacy.toArray is defined ? privacy.toArray() : privacy|default({}) %}
{% set cookies = privacy.cookies|default([]) %}
{% set used = cookies|column('category') %}
{% set consent_categories = ['preferences', 'analytics', 'marketing', 'third_party']|filter(category => category in used)|merge([]) %}

{% if consent_categories is not empty %}
    {% set locale = app.request.locale|default('cs') %}
    {% set policy_url = locale_link('/zasady-ochrany-osobnich-udaju') %}

    {# Design hooks #}
    {% set consent_button = 'inline-flex min-h-11 w-full items-center justify-center rounded-sm bg-accent px-4 py-2.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent' %}
    {% set settings_button = 'inline-flex min-h-11 w-full items-center justify-center rounded-sm border border-night-ink-3 px-4 py-2.5 text-sm font-semibold text-night-ink transition-colors hover:bg-night-deep cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-night-ink' %}

    {# CB-14: controllers (all of them, VAR-13), purposes and named third parties #}
    {% set controller_names = privacy.controllers|default([])|map(controller => controller.name)|join(', ', ' ' ~ __('cookie.and') ~ ' ') %}
    {% set purposes_text = consent_categories|map(category => __('cookie.category.' ~ category ~ '.short'))|join(', ', ' ' ~ __('cookie.and') ~ ' ') %}
    {% set consent_recipients = [] %}
    {% for purpose in privacy.purposes|default([])|filter(purpose => purpose.legal_basis == 'art6_1_a') %}
        {% set consent_recipients = consent_recipients|merge(purpose.recipients|default([])) %}
    {% endfor %}
    {% set providers = [] %}
    {% for recipient in privacy.recipients|default([])|filter(recipient => recipient.id in consent_recipients) %}
        {% if recipient.name not in providers %}
            {% set providers = providers|merge([recipient.name]) %}
        {% endif %}
    {% endfor %}

    {# ---------------------------------------------------------------- Layer 1 #}
    <section id="cookie-banner"
             data-cookie-banner
             role="dialog"
             aria-modal="false"
             aria-labelledby="cookie-banner-title"
             aria-describedby="cookie-banner-desc"
             hidden
             class="fixed inset-x-0 bottom-0 z-40 p-2 font-body sm:p-4 print:hidden">
        <div class="mx-auto flex max-w-5xl flex-col gap-4 rounded-md border border-night-stroke bg-night p-4 text-night-ink shadow-2xl sm:p-5 lg:flex-row lg:items-end lg:gap-8">

            {# Scrolls on small screens so the buttons always stay visible at 360 px (CB-15) #}
            <div class="max-h-[38vh] overflow-y-auto lg:max-h-none">
                <h2 id="cookie-banner-title" class="mb-1 text-base font-semibold text-night-ink">{{ __('cookie.title') }}</h2>
                <div id="cookie-banner-desc" class="space-y-1 text-sm leading-relaxed text-night-ink-2">
                    <p>
                        {{ __('cookie.text', { '%purposes%': purposes_text }) }}
                        {% if providers is not empty %}
                            {{ __('cookie.recipients', { '%providers%': providers|join(', ') }) }}
                        {% endif %}
                        {{ __('cookie.necessary_only') }}
                    </p>
                    <p>
                        {% if privacy.controllers|default([])|length > 1 %}
                            {{ __(privacy.controller_model|default('') in ['joint', 'hybrid'] ? 'cookie.controllers_joint' : 'cookie.controllers', { '%controllers%': controller_names }) }}
                        {% else %}
                            {{ __('cookie.controller', { '%controllers%': controller_names }) }}
                        {% endif %}
                        {{ __('cookie.withdraw') }}
                    </p>
                </div>
                <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    <a href="{{ policy_url }}" class="font-medium text-night-ink underline underline-offset-2 hover:text-accent-ink-2">{{ __('cookie.policy_link') }}</a>
                    <a href="{{ locale_link('/zasady-ochrany-osobnich-udaju#cookies') }}" class="font-medium text-night-ink underline underline-offset-2 hover:text-accent-ink-2">{{ __('cookie.list_link') }}</a>
                </p>
            </div>

            <div class="grid shrink-0 grid-cols-2 gap-2 lg:w-80">
                <button type="button" id="cookie-btn-reject" data-cookie-reject class="{{ consent_button }}">{{ __('cookie.reject') }}</button>
                <button type="button" id="cookie-btn-accept" data-cookie-accept class="{{ consent_button }}">{{ __('cookie.accept') }}</button>
                <button type="button" id="cookie-btn-settings" data-cookie-settings aria-haspopup="dialog" aria-controls="cookie-settings" class="col-span-2 {{ settings_button }}">{{ __('cookie.settings') }}</button>
            </div>
        </div>
    </section>

    {# ---------------------------------------------------------------- Layer 2 #}
    <dialog id="cookie-settings"
            data-cookie-dialog
            aria-labelledby="cookie-settings-title"
            class="m-auto w-[min(44rem,calc(100%-1rem))] max-h-[calc(100dvh-1rem)] overflow-hidden rounded-md bg-canvas p-0 font-body text-ink shadow-2xl backdrop:bg-night/70 print:hidden">
        <div class="flex max-h-[calc(100dvh-1rem)] flex-col">
            <header class="flex items-start justify-between gap-4 border-b border-stroke p-4 sm:p-5">
                <div>
                    <h2 id="cookie-settings-title" class="text-lg font-semibold">{{ __('cookie.settings') }}</h2>
                    <p class="mt-1 text-sm text-ink-2">{{ __('cookie.settings_intro') }}</p>
                </div>
                <button type="button" data-cookie-close class="-m-2 shrink-0 rounded-sm p-2 text-ink-2 hover:text-ink cursor-pointer focus-visible:outline-2 focus-visible:outline-accent">
                    <span class="sr-only">{{ __('cookie.close') }}</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </header>

            <div class="flex-1 space-y-3 overflow-y-auto p-4 sm:p-5">
                {% for category in ['necessary']|merge(consent_categories) %}
                    {% set items = cookies|filter(item => item.category == category) %}
                    <section class="rounded-sm border border-stroke">
                        <div class="flex items-start justify-between gap-4 p-4">
                            <div>
                                <h3 id="cookie-category-{{ category }}" class="font-semibold">{{ __('cookie.category.' ~ category ~ '.title') }}</h3>
                                <p id="cookie-category-{{ category }}-desc" class="mt-1 text-sm text-ink-2">{{ __('cookie.category.' ~ category ~ '.desc') }}</p>
                            </div>

                            {% set switch_classes = 'group relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-ink-3 transition-colors aria-checked:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent' %}
                            {% if category == 'necessary' %}
                                {# Always on and not changeable, with the reason in the description (CB-20) #}
                                <span class="flex shrink-0 flex-col items-end gap-1">
                                    <button type="button" role="switch" aria-checked="true" aria-disabled="true" disabled
                                            aria-labelledby="cookie-category-necessary" aria-describedby="cookie-category-necessary-desc"
                                            class="{{ switch_classes }} opacity-60">
                                        <span aria-hidden="true" class="pointer-events-none inline-block size-5 translate-x-0.5 rounded-full bg-white shadow transition-transform group-aria-checked:translate-x-5.5"></span>
                                    </button>
                                    <span class="text-xs text-ink-3">{{ __('cookie.always_active') }}</span>
                                </span>
                            {% else %}
                                <button type="button" role="switch" aria-checked="false" data-cookie-category="{{ category }}"
                                        aria-labelledby="cookie-category-{{ category }}" aria-describedby="cookie-category-{{ category }}-desc"
                                        class="{{ switch_classes }} cursor-pointer">
                                    <span aria-hidden="true" class="pointer-events-none inline-block size-5 translate-x-0.5 rounded-full bg-white shadow transition-transform group-aria-checked:translate-x-5.5"></span>
                                </button>
                            {% endif %}
                        </div>

                        <details class="border-t border-stroke">
                            <summary class="cursor-pointer px-4 py-2 text-sm font-medium text-ink-2 hover:text-ink">
                                {{ __('cookie.show_items', { '%count%': items|length }) }}
                            </summary>
                            <div class="px-4 pb-4">
                                {% include 'partials/_cookie-table.twig' with { items: items } only %}
                            </div>
                        </details>
                    </section>
                {% endfor %}

                <p class="text-sm text-ink-2">
                    <a href="{{ policy_url }}" class="font-medium text-accent underline underline-offset-2 hover:text-accent-hover">{{ __('cookie.policy_link') }}</a>
                </p>
            </div>

            <footer class="grid gap-2 border-t border-stroke p-4 sm:grid-cols-3 sm:p-5">
                <button type="button" id="cookie-dialog-reject" data-cookie-reject class="{{ consent_button }}">{{ __('cookie.reject') }}</button>
                <button type="button" id="cookie-dialog-save" data-cookie-save class="{{ consent_button }}">{{ __('cookie.save') }}</button>
                <button type="button" id="cookie-dialog-accept" data-cookie-accept class="{{ consent_button }}">{{ __('cookie.accept') }}</button>
            </footer>
        </div>
    </dialog>
{% endif %}
