{#
  partials/_consent-mode.twig — consent configuration for js/src/cookie-consent.ts (bolt-cookie-consent).
  Included in <head> of partials/_master.twig.

  Prints JSON only — no executable inline script, so a strict Content-Security-Policy keeps
  working — and prints nothing when theme.yaml lists no consent category (only necessary
  items: no banner is needed, the footer then shows only the privacy policy link).

  Everything comes from theme.yaml:
    analytics.ga4_id / google_ads_id / sklik_id   tracker IDs
    analytics.consent_mode                        basic (default) | advanced — operator's decision (CB-50)
    privacy.cookies                               inventory; a tracker runs only when its category
                                                  has items there (INV-03: nothing unclassified)
    privacy.config_version / privacy.consent      re-ask rules (CB-41, CB-42)

  Never add preconnect / dns-prefetch hints for tracker domains here: they contact the third
  party before consent (CB-01).
#}
{% set privacy = config.get('theme/privacy')|default({}) %}
{% set analytics = config.get('theme/analytics')|default({}) %}
{% set cookies = privacy.cookies|default([]) %}
{% set used = cookies|column('category') %}
{% set consent_categories = ['preferences', 'analytics', 'marketing', 'third_party']|filter(category => category in used)|merge([]) %}

{% if consent_categories is not empty %}
    {# First-party cookie names per category, deleted when consent is withdrawn (CB-31). #}
    {% set first_party = {} %}
    {% for category in consent_categories %}
        {% set names = [] %}
        {% for item in cookies|filter(item => item.category == category and item.party|default('third') == 'first' and item.technology|default('cookie') == 'cookie') %}
            {% set names = names|merge(item.name|split(',')|map(name => name|trim)) %}
        {% endfor %}
        {% set first_party = first_party|merge({(category): names}) %}
    {% endfor %}

    {# gaCookieExpires: 13 months in seconds instead of GA's 2-year default (CB-24). #}
    <script type="application/json" id="cookie-consent-config">
        {{- {
            version: privacy.config_version|default(1),
            validityMonths: privacy.consent.validity_months|default(12),
            reaskMonths: privacy.consent.reask_after_reject_months|default(6),
            mode: analytics.consent_mode|default('basic') == 'advanced' ? 'advanced' : 'basic',
            categories: consent_categories,
            cookies: first_party,
            ga4: 'analytics' in consent_categories ? analytics.ga4_id|default(null) : null,
            googleAds: 'marketing' in consent_categories ? analytics.google_ads_id|default(null) : null,
            sklik: 'marketing' in consent_categories ? analytics.sklik_id|default(null) : null,
            gaCookieExpires: 34128000,
        }|json_encode|raw -}}
    </script>
{% endif %}
