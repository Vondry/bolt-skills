{#
  partials/_consent-embed.twig — third-party embed behind consent (CB-02, bolt-cookie-consent).

  Before consent a placeholder says what will load and from whom; "Načíst obsah" grants only
  this embed's category and swaps in the iframe (js/src/cookie-consent.ts). Visitors who have
  already granted the category get the iframe right away. Never put a YouTube / map iframe
  directly in a template — verify.sh reports it.

  {% include 'partials/_consent-embed.twig' with {
      src: 'https://www.youtube-nocookie.com/embed/VIDEO_ID',
      title: 'Prohlídka dílny',
      provider: 'YouTube (Google Ireland Limited)',
      ratio: 'aspect-video',           {# optional, e.g. 'aspect-square' or 'h-96' for maps #}
      category: 'third_party'          {# optional #}
  } only %}

  theme.yaml privacy.cookies must list the provider's items in the same category (references/cookie-catalog.yaml → embeds).
  Translation keys: cookie.embed.*, cookie.settings
#}
<div data-consent-embed
     data-consent-category="{{ category|default('third_party') }}"
     class="relative w-full overflow-hidden rounded-sm border border-stroke bg-surface {{ ratio|default('aspect-video') }}">
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 overflow-y-auto p-4 text-center sm:p-6">
        <p class="font-semibold text-ink">{{ title }}</p>
        <p class="max-w-md text-sm text-ink-2">{{ __('cookie.embed.text', { '%provider%': provider }) }}</p>
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
            <button type="button" data-consent-embed-load class="btn-primary">{{ __('cookie.embed.load') }}</button>
            <button type="button" data-cookie-settings class="text-sm text-ink-2 underline underline-offset-2 hover:text-ink cursor-pointer">{{ __('cookie.settings') }}</button>
        </div>
    </div>
    <template>
        <iframe src="{{ src }}"
                title="{{ title }}"
                class="absolute inset-0 size-full border-0"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                allowfullscreen></iframe>
    </template>
</div>
