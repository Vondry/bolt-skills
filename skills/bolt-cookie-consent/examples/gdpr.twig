{% extends 'partials/_master.twig' %}

{#
  static-pages/gdpr.twig — Zásady ochrany osobních údajů (bolt-cookie-consent).
  Route: /zasady-ochrany-osobnich-udaju (+ /{_locale}/…), see config/routes.yaml.

  GDPR čl. 12–14 and 21/4, ZEK § 89/3; requirement IDs refer to references/guidelines.cs.md.
  Every fact comes from theme.yaml privacy: — the same data as the cookie banner, so the page and
  the banner never disagree. Fixed legal wording (rights, objection, ÚOOÚ) lives in the XLIFF
  catalogs (privacy.*). Section order follows the guidelines' "Doporučené pořadí na stránce";
  each of the 11 mandatory blocks is filled or says explicitly that it does not apply.

  The anchors (#spravce, #ucely, #cookies, …) are linked from the banner and the form notes.
#}

{% import 'partials/_privacy-macros.twig' as privacy_ui %}

{% block main %}
    {# Plain arrays: theme.yaml blocks come as Bolt collections — |column() finds nothing in them and a key
       set to ~ throws on access. toArray() converts recursively. #}
    {% set privacy = config.get('theme/privacy') %}
    {% set privacy = privacy.toArray is defined ? privacy.toArray() : privacy|default({}) %}
    {% set locale = app.request.locale|default('cs') %}
    {% set controllers = privacy.controllers|default([]) %}
    {% set purposes = privacy.purposes|default([]) %}
    {% set recipients = privacy.recipients|default([]) %}
    {% set cookies = privacy.cookies|default([]) %}
    {% set used = cookies|column('category') %}
    {% set consent_categories = ['preferences', 'analytics', 'marketing', 'third_party']|filter(category => category in used)|merge([]) %}
    {% set multiple = controllers|length > 1 %}
    {% set joint = privacy.controller_model|default('single') in ['joint', 'hybrid'] %}
    {% set contact_id = privacy.joint_arrangement.contact_controller ?? (controllers|first).id ?? null %}
    {% set contact = controllers|filter(controller => controller.id == contact_id)|first %}
    {% set analytics = config.get('theme/analytics') %}
    {% set analytics = analytics.toArray is defined ? analytics.toArray() : analytics|default({}) %}
    {% set google = ('analytics' in consent_categories and analytics.ga4_id|default(null)) or ('marketing' in consent_categories and analytics.google_ads_id|default(null)) %}

    {% set h2 = 'font-display text-card font-semibold text-ink scroll-mt-24' %}
    {% set cell = 'border-b border-stroke py-3 pr-4 align-top' %}
    {% set head_cell = 'border-b border-stroke py-2 pr-4 text-left font-semibold text-ink-2' %}
    {% set link = 'text-accent underline underline-offset-2 hover:text-accent-hover' %}

    {# The cookie banner does not cover this page (PP-05); its settings button is in #cookies. #}
    <div data-cookie-banner-defer hidden></div>

    <article class="wrapper px-edge py-section font-body">
        <div class="mx-auto max-w-4xl space-y-12 leading-relaxed text-ink">

            {# 1. Title, effective date and version (PP-06) #}
            <header>
                <h1 class="font-display text-section font-semibold text-ink">{{ __('privacy.title') }}</h1>
                <p class="mt-2 text-sm text-ink-3">
                    {{ __('privacy.effective', { '%date%': privacy_ui.date(privacy.effective_date|default('')), '%version%': privacy.config_version|default(1) }) }}
                </p>
            </header>

            {# 2. Summary in 3–5 sentences (PP-04) #}
            <section aria-label="{{ __('privacy.summary.label') }}" class="rounded-md bg-surface p-5 sm:p-6">
                {% if privacy.summary|default(null) %}
                    <p>{{ privacy_ui.t(privacy.summary) }}</p>
                {% else %}
                    <p>{{ __('privacy.summary.default') }}{% if consent_categories is not empty %} {{ __('privacy.summary.consent') }}{% endif %}</p>
                {% endif %}
            </section>

            {# 3. Controller(s) — one card each, same structure (čl. 13/1 a, b; § 435 OZ; VAR-30) #}
            <section id="spravce" aria-labelledby="spravce-title">
                <h2 id="spravce-title" class="{{ h2 }}">{{ __(multiple ? 'privacy.controllers.title' : 'privacy.controller.title') }}</h2>
                <div class="mt-4 grid gap-4 {{ multiple ? 'sm:grid-cols-2' }}">
                    {% for controller in controllers %}
                        <div class="rounded-md border border-stroke p-5">
                            <p class="font-semibold">{{ controller.name }}</p>
                            <dl class="mt-2 space-y-1 text-sm">
                                {% if controller.legal_form|default(null) %}<div><dt class="inline text-ink-3">{{ __('privacy.controller.legal_form') }}:</dt> <dd class="inline">{{ controller.legal_form }}</dd></div>{% endif %}
                                {# A controller with business: false (private person) may have no address, IČO or register entry. #}
                                {% if controller.address|default(null) %}<div><dt class="inline text-ink-3">{{ __('privacy.controller.address') }}:</dt> <dd class="inline">{{ controller.address }}</dd></div>{% endif %}
                                {% if controller.ico|default(null) %}<div><dt class="inline text-ink-3">{{ __('privacy.controller.ico') }}:</dt> <dd class="inline">{{ controller.ico }}</dd></div>{% endif %}
                                {% if controller.registry|default(null) %}<div><dt class="inline text-ink-3">{{ __('privacy.controller.registry') }}:</dt> <dd class="inline">{{ privacy_ui.t(controller.registry) }}</dd></div>{% endif %}
                                <div><dt class="inline text-ink-3">{{ __('privacy.controller.email') }}:</dt> <dd class="inline"><a href="mailto:{{ controller.privacy_email }}" class="{{ link }}">{{ controller.privacy_email }}</a></dd></div>
                                <div>
                                    <dt class="inline text-ink-3">{{ __('privacy.controller.dpo') }}:</dt>
                                    <dd class="inline">
                                        {% if controller.dpo|default(null) %}
                                            {{ controller.dpo.name ?? controller.dpo }}{% if controller.dpo.email ?? null %}, <a href="mailto:{{ controller.dpo.email }}" class="{{ link }}">{{ controller.dpo.email }}</a>{% endif %}
                                        {% else %}
                                            {{ __('privacy.controller.no_dpo') }}
                                        {% endif %}
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# 4. Table of contents #}
            <nav aria-labelledby="obsah-zasad-title" class="border-l-2 border-accent pl-4">
                <h2 id="obsah-zasad-title" class="text-sm font-semibold uppercase tracking-wider text-ink-3">{{ __('privacy.toc') }}</h2>
                <ol class="mt-2 grid gap-1 text-sm sm:grid-cols-2">
                    <li><a href="#ucely" class="{{ link }}">{{ __('privacy.purposes.title') }}</a></li>
                    <li><a href="#prijemci" class="{{ link }}">{{ __('privacy.recipients.title') }}</a></li>
                    <li><a href="#prava" class="{{ link }}">{{ __('privacy.rights.title') }}</a></li>
                    <li><a href="#namitka" class="{{ link }}">{{ __('privacy.objection.title') }}</a></li>
                    <li><a href="#cookies" class="{{ link }}">{{ __('privacy.cookies.title') }}</a></li>
                    {% if joint %}<li><a href="#spolecne-spravcovstvi" class="{{ link }}">{{ __('privacy.joint.title') }}</a></li>{% endif %}
                    <li><a href="#kontakt" class="{{ link }}">{{ __('privacy.contact.title') }}</a></li>
                    <li><a href="#historie-zmen" class="{{ link }}">{{ __('privacy.changelog.title') }}</a></li>
                </ol>
            </nav>

            {# 5. Purposes → data → legal basis → retention (čl. 13/1 c, d; 13/2 a, e; VAR-20, VAR-31).
                  `section: website` = shared part; `section: <controller id>` = that controller's own section. #}
            <section id="ucely" aria-labelledby="ucely-title">
                <h2 id="ucely-title" class="{{ h2 }}">{{ __('privacy.purposes.title') }}</h2>
                {% set sections = [{ id: 'website', title: null }] %}
                {% for controller in controllers %}
                    {% set sections = sections|merge([{ id: controller.id, title: controller.name }]) %}
                {% endfor %}

                {% for section in sections %}
                    {% set rows = purposes|filter(purpose => purpose.section|default('website') == section.id) %}
                    {% if rows|length > 0 %}
                        {% if section.title %}<h3 class="mt-6 font-semibold">{{ __('privacy.purposes.of_controller', { '%controller%': section.title }) }}</h3>{% endif %}
                        <div class="mt-4 overflow-x-auto">
                            <table class="w-full min-w-176 border-collapse text-sm">
                                <thead>
                                    <tr>
                                        <th scope="col" class="{{ head_cell }}">{{ __('privacy.purposes.purpose') }}</th>
                                        {% if multiple %}<th scope="col" class="{{ head_cell }}">{{ __('privacy.purposes.controller') }}</th>{% endif %}
                                        <th scope="col" class="{{ head_cell }}">{{ __('privacy.purposes.data') }}</th>
                                        <th scope="col" class="{{ head_cell }}">{{ __('privacy.purposes.basis') }}</th>
                                        <th scope="col" class="{{ head_cell }}">{{ __('privacy.purposes.retention') }}</th>
                                        <th scope="col" class="{{ head_cell }}">{{ __('privacy.purposes.provision') }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for purpose in rows %}
                                        {% set purpose_controllers = purpose.controllers|default([]) %}
                                        <tr>
                                            <th scope="row" class="{{ cell }} text-left font-semibold">{{ privacy_ui.t(purpose.title) }}</th>
                                            {% if multiple %}
                                                <td class="{{ cell }}">{{ controllers|filter(controller => controller.id in purpose_controllers)|map(controller => controller.name)|join(', ') }}</td>
                                            {% endif %}
                                            <td class="{{ cell }}">{{ privacy_ui.t(purpose.data) }}</td>
                                            <td class="{{ cell }}">
                                                {{ __('privacy.basis.' ~ purpose.legal_basis) }}
                                                {% if purpose.legitimate_interest|default(null) %}
                                                    <span class="mt-1 block text-ink-2">{{ __('privacy.basis.interest', { '%interest%': purpose.legitimate_interest[locale] ?? purpose.legitimate_interest.cs ?? purpose.legitimate_interest }) }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="{{ cell }}">{{ privacy_ui.t(purpose.retention) }}</td>
                                            <td class="{{ cell }}">{{ privacy_ui.t(purpose.provision) }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                {% endfor %}

                {# 8. Automated decision-making (čl. 13/2 f) — always stated explicitly #}
                <p class="mt-4 text-sm text-ink-2">
                    {% if privacy.automated_decision_making|default(false) %}
                        {{ privacy_ui.t(privacy.automated_decision_making) }}
                    {% else %}
                        {{ __('privacy.automated.none') }}
                    {% endif %}
                </p>
            </section>

            {# 6. Recipients and transfers outside the EU/EEA (čl. 13/1 e, f) #}
            <section id="prijemci" aria-labelledby="prijemci-title">
                <h2 id="prijemci-title" class="{{ h2 }}">{{ __('privacy.recipients.title') }}</h2>
                {% if recipients is not empty %}
                    <p class="mt-2">{{ __('privacy.recipients.intro') }}</p>
                    <div class="mt-4 overflow-x-auto">
                        <table class="w-full min-w-160 border-collapse text-sm">
                            <thead>
                                <tr>
                                    <th scope="col" class="{{ head_cell }}">{{ __('privacy.recipients.name') }}</th>
                                    <th scope="col" class="{{ head_cell }}">{{ __('privacy.recipients.role') }}</th>
                                    <th scope="col" class="{{ head_cell }}">{{ __('privacy.recipients.purpose') }}</th>
                                    <th scope="col" class="{{ head_cell }}">{{ __('privacy.recipients.country') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for recipient in recipients %}
                                    <tr>
                                        <th scope="row" class="{{ cell }} text-left font-semibold">{{ recipient.name }}</th>
                                        <td class="{{ cell }}">{{ __('privacy.role.' ~ recipient.role|default('processor')) }}</td>
                                        <td class="{{ cell }}">{{ privacy_ui.t(recipient.purpose) }}</td>
                                        <td class="{{ cell }}">
                                            {{ privacy_ui.t(recipient.country) }}
                                            {% if recipient.transfer|default(null) %}
                                                <span class="mt-1 block text-ink-2">{{ __('privacy.transfer.' ~ recipient.transfer) }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="mt-2">{{ __('privacy.recipients.none') }}</p>
                {% endif %}
            </section>

            {# 7. Rights (čl. 13/2 b–d) #}
            <section id="prava" aria-labelledby="prava-title">
                <h2 id="prava-title" class="{{ h2 }}">{{ __('privacy.rights.title') }}</h2>
                <ul class="mt-3 list-disc space-y-2 pl-6">
                    <li>{{ __('privacy.rights.access') }}</li>
                    <li>{{ __('privacy.rights.rectification') }}</li>
                    <li>{{ __('privacy.rights.erasure') }}</li>
                    <li>{{ __('privacy.rights.restriction') }}</li>
                    <li>{{ __('privacy.rights.portability') }}</li>
                    <li>
                        {{ __('privacy.rights.withdraw') }}
                        {% if consent_categories is not empty %}
                            <button type="button" data-cookie-settings class="font-semibold {{ link }} cursor-pointer">{{ __('cookie.settings') }}</button>
                        {% endif %}
                    </li>
                    <li>{{ __('privacy.rights.complaint') }} <a href="https://uoou.gov.cz" rel="noopener" class="{{ link }}">uoou.gov.cz</a></li>
                </ul>
            </section>

            {# Objection — a separate, visually distinct block (čl. 21/4) #}
            <section id="namitka" aria-labelledby="namitka-title" class="rounded-md border-2 border-accent p-5 sm:p-6">
                <h2 id="namitka-title" class="{{ h2 }}">{{ __('privacy.objection.title') }}</h2>
                <p class="mt-2">{{ __('privacy.objection.text') }}</p>
                <p class="mt-2">{{ __('privacy.objection.marketing') }}</p>
            </section>

            {# 9. Cookies — the same items as the banner (ZEK § 89/3) #}
            <section id="cookies" aria-labelledby="cookies-title">
                <h2 id="cookies-title" class="{{ h2 }}">{{ __('privacy.cookies.title') }}</h2>
                <p class="mt-2">{{ __(consent_categories is not empty ? 'privacy.cookies.intro' : (cookies is empty ? 'privacy.cookies.none' : 'privacy.cookies.intro_necessary_only')) }}</p>
                {% if google %}
                    <p class="mt-2">{{ __(analytics.consent_mode|default('basic') == 'advanced' ? 'privacy.cookies.consent_mode_advanced' : 'privacy.cookies.consent_mode_basic') }}</p>
                {% endif %}

                {% for category in ['necessary']|merge(consent_categories) %}
                    {% set items = cookies|filter(item => item.category == category) %}
                    {% if items|length > 0 %}
                    <h3 class="mt-6 font-semibold">{{ __('cookie.category.' ~ category ~ '.title') }}</h3>
                    <p class="mt-1 text-sm text-ink-2">{{ __('cookie.category.' ~ category ~ '.desc') }}</p>
                    <div class="mt-3">
                        {% include 'partials/_cookie-table.twig' with { items: items } only %}
                    </div>
                    {% endif %}
                {% endfor %}

                {% if consent_categories is not empty %}
                    <button type="button" data-cookie-settings class="btn-primary mt-6">{{ __('cookie.settings') }}</button>
                {% endif %}
            </section>

            {# 11. Joint controllers (čl. 26/2, 26/3; VAR-11, VAR-12) #}
            {% if joint %}
                <section id="spolecne-spravcovstvi" aria-labelledby="spolecne-title">
                    <h2 id="spolecne-title" class="{{ h2 }}">{{ __('privacy.joint.title') }}</h2>
                    <p class="mt-2">{{ privacy_ui.t(privacy.joint_arrangement.summary ?? '') }}</p>
                    <p class="mt-2">{{ __('privacy.joint.any_controller') }}</p>
                </section>
            {% endif %}

            {# 10. Exercising rights — one contact channel (čl. 12/3; VAR-32) and the ÚOOÚ #}
            <section id="kontakt" aria-labelledby="kontakt-title">
                <h2 id="kontakt-title" class="{{ h2 }}">{{ __('privacy.contact.title') }}</h2>
                <p class="mt-2">
                    {{ __('privacy.contact.text') }}
                    {% if contact %}<a href="mailto:{{ contact.privacy_email }}" class="{{ link }}">{{ contact.privacy_email }}</a>{% endif %}
                </p>
                <p class="mt-2">{{ __('privacy.contact.response') }}</p>
                <p class="mt-2">{{ __('privacy.contact.authority') }}</p>
            </section>

            {# Change history (PP-06) #}
            <section id="historie-zmen" aria-labelledby="historie-title">
                <h2 id="historie-title" class="{{ h2 }}">{{ __('privacy.changelog.title') }}</h2>
                <ul class="mt-3 space-y-1 text-sm">
                    {% for entry in privacy.changelog|default([]) %}
                        <li>
                            <span class="font-semibold">{{ __('privacy.changelog.version', { '%version%': entry.version }) }}</span>
                            ({{ privacy_ui.date(entry.date) }}) — {{ privacy_ui.t(entry.change) }}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </article>
{% endblock main %}
