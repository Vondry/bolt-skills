# .env — committed and uploaded with the code: everything production needs, including the secret.
#
#   .env        — production values. Upload it; the site runs from it alone.
#   .env.local  — local development only (APP_ENV=dev, APP_DEBUG=1, any host). Never upload it:
#                 on the server it would switch production into dev mode.
#
# Real environment variables win over .env files.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Signs sessions, CSRF tokens and remember-me cookies. A new one logs everybody out.
# Generate: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=
# Hosts the site answers to (a regular expression). Any other Host header gets HTTP 400, so
# password-reset links can never point to an attacker's domain.
SYMFONY_TRUSTED_HOSTS='^(www\.)?example\.cz$'
# Address range of a TLS-terminating proxy in front of the site, if any (empty: none).
SYMFONY_TRUSTED_PROXIES=
BOLT_CONFIG_FOLDER='config/bolt'
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# SQLite in var/data/ (never upload var/ — it would overwrite the live database).
DATABASE_URL=sqlite:///%kernel.project_dir%/var/data/bolt.sqlite
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
###< nelmio/cors-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost
###< symfony/mailer ###

# The one host that serves the site; the other (www / without www) redirects to it (bolt-htaccess).
# Canonical links then always name this host.
BOLT_CANONICAL=https://example.cz
